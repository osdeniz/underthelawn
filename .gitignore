# Godot 4 editor cache + per-machine credentials
.godot/
# Godot may store signing/keystore paths here; uncomment if it ever holds secrets
# export_presets.cfg

# macOS
.DS_Store
*.xcframework/
out/*
# ...but this one file must survive a clone: it is what stops Godot importing
# 900 MB of movie-capture frames into the pack (G16).
!out/.gdignore

# Godot export output (regenerated by exporting, not source)
*.pck
