; Under The Lawn — Godot 4 port of the LastLawn SceneKit prototype.
; Engine configuration file.

config_version=5

[application]

config/name="Under The Lawn"
config/description="Mobil çim biçme oyunu — REFERENCE.md spesifikasyonuna göre."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/game_state.gd"
Haptics="*res://scripts/haptics.gd"
AudioDirector="*res://scripts/audio_director.gd"

[display]

; Portrait, 1170x2532 base resolution (iPhone). 3D game, so stretch mode is
; viewport rather than canvas_items. The window overrides only affect desktop
; testing; the logical viewport stays 1170x2532.
window/size/viewport_width=1170
window/size/viewport_height=2532
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="viewport"
window/stretch/aspect="keep_height"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
