; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Under The Lawn"
config/description="Mobil çim biçme oyunu — REFERENCE.md spesifikasyonuna göre."
run/main_scene="res://scenes/Root.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/game_state.gd"
Haptics="*res://scripts/haptics.gd"
AudioDirector="*res://scripts/audio_director.gd"

[display]

window/size/viewport_width=1170
window/size/viewport_height=2532
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="viewport"
window/stretch/aspect="keep_height"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=1024
anti_aliasing/quality/msaa_3d=2

[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.en.translation", "res://i18n/strings.tr.translation")
locale/fallback="en"
; 0 = based on the application locale, so an RTL language (Arabic, Hebrew)
; mirrors the whole UI instead of only reversing the text runs. NOTE: 2 is
; "force RTL", not "locale based" -- setting 2 mirrored the whole English UI.
rendering/root_node_layout_direction=0
