[gd_scene load_steps=20 format=3]

; Ride-on tractor, REFERENCE.md §6. Faces -Z. Yellow 1.5 x 0.9 cutting deck,
; green 0.75 x 0.3 x 1.9 chassis with a hood, steering column + torus wheel,
; seat + backrest, rear wheels r0.30 and front r0.18 on yellow rims.
; Body colour (0.22,0.45,0.16), accent (0.95,0.78,0.15).

[ext_resource type="Script" path="res://scripts/tractor_mower.gd" id="1_tractor"]
[ext_resource type="Texture2D" path="res://textures/leaf_particle.png" id="2_leaf"]

[sub_resource type="StandardMaterial3D" id="Mat_body"]
