[gd_scene load_steps=15 format=3]

; Robot mower, REFERENCE.md §6. Flat dark cylinder base r0.42 x 0.12, flattened
; hemisphere shell r0.40 at y-scale 0.42, emissive cyan LED torus that breathes
; over 0.9 s, a front sensor eye and a red-tipped antenna.

[ext_resource type="Script" path="res://scripts/robot_mower.gd" id="1_robot"]
[ext_resource type="Texture2D" path="res://textures/leaf_particle.png" id="2_leaf"]

[sub_resource type="StandardMaterial3D" id="Mat_dark"]
